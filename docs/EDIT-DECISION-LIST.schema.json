{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teag3.example/schemas/edit-decision-list.schema.json",
  "title": "TEa.G3 Edit Decision List",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "status", "timeline"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "validated", "approved", "rendering", "rendered", "failed"] },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "frameRate": { "type": "number", "exclusiveMinimum": 0 },
        "videoCodec": { "type": "string" },
        "audioCodec": { "type": "string" },
        "container": { "type": "string", "enum": ["mp4"] }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clipId", "sourceInMs", "sourceOutMs", "timelineStartMs"],
        "properties": {
          "clipId": { "type": "string", "minLength": 1 },
          "sourceInMs": { "type": "integer", "minimum": 0 },
          "sourceOutMs": { "type": "integer", "minimum": 1 },
          "timelineStartMs": { "type": "integer", "minimum": 0 },
          "volume": { "type": "number", "minimum": 0, "maximum": 4 },
          "captionTrackId": { "type": "string" }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "startMs", "endMs", "language"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 1 },
          "language": { "type": "string" },
          "direction": { "type": "string", "enum": ["ltr", "rtl"] }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
